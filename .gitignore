# .gitignore for Rocksmith Generic Cable Guide

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.bak
*.swp
*~

# User-specific config (don't commit GUIDs)
scripts/user-config.txt

# Testing
test-results/
*.log

# Secrets and credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# Machine-specific debug output (can contain usernames, device IDs, paths)
*.mdmp
*.dmp
*.reg
audiodump.txt
RS_ASIO-log.txt
